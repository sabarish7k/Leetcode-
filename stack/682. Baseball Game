"""FIRST WE NEED TO PUSH ALL THE CORRECT SCORES IN STACCK AND WE NEED TO FINALLY ADD IT TOGETHER AND WHEN STACK BECOMMES EMPTY THE SUM VALUE WILL BE THE FINAL SCORE """

class Solution {
    public int calPoints(String[] operations) {
       int sum=0;
       Stack <Integer> st=new Stack<>();
       for(int i=0;i<operations.length;i++){
        if(operations[i].equals("C")){
            st.pop();
        }
        else if(operations[i].equals("D")){
            int t=st.pop();
            st.push(t);
            st.push(t*2);
        }
        else if(operations[i].equals("+")){
            int a=st.pop();
            int b=st.pop();
            st.push(b);
            st.push(a);
            st.push(a+b);

        }
        else{
            int y=(Integer.parseInt(operations[i]));
            st.push(y);
        }
       }
       while(!st.isEmpty()){
        sum+=st.pop();
       }
return sum;
    }
}
